{
    "layer": "top",
    "position": "top",

    "height": 42,

    "modules-left": [
        "custom/appmenu",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "network",
        "backlight",
        "pulseaudio",
        "battery"
    ],

    // ─────────────────────────────
    // APP MENU
    // ─────────────────────────────

    "custom/appmenu": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },

    // ─────────────────────────────
    // HYPRLAND WORKSPACES
    // ─────────────────────────────

    "hyprland/workspaces": {
        "format": "{icon} {name}",

        "format-icons": {
            "active": "●",
            "default": "•"
        },

        "persistent-workspaces": {
            "*": [1, 2]
        },

        "sort-by": "number",
        "disable-scroll": false,
        "enable-bar-scroll": false,
        "tooltip": false
    },

    // ─────────────────────────────
    // CLOCK
    // ─────────────────────────────

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d %B %Y}",
        "tooltip": true,
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
    },

    // ─────────────────────────────
    // CPU
    // ─────────────────────────────

    "cpu": {
        "interval": 2,
        "format": "{icon0}{icon1}{icon2}{icon3}",
        "format-icons": [
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ],
        "tooltip": true,
        "tooltip-format": "CPU: {usage}%"
    },

    // ─────────────────────────────
    // MEMORY
    // ─────────────────────────────

    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB"
    },

    // ─────────────────────────────
    // NETWORK
    // ─────────────────────────────

    "network": {
        "interval": 2,
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",

        "tooltip": true,

        "tooltip-format-wifi": "Wi-Fi\nSSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",

        "tooltip-format-ethernet": "Ethernet\nInterface: {ifname}\nIP: {ipaddr}",

        "tooltip-format-disconnected": "Network disconnected",

        "format-alt": " {bandwidthDownBytes}   {bandwidthUpBytes}"
    },

    // ─────────────────────────────
    // AUDIO
    // ─────────────────────────────

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",

        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },

        "on-click": "pavucontrol",
        "tooltip": true
    },

    // ─────────────────────────────
    // Brightness
    // ────────────────────────────

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],

        "tooltip": true,
        "tooltip-format": "Brightness: {percent}%",

        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",

        "smooth-scrolling-threshold": 1
    },

    // ─────────────────────────────
    // BATTERY
    // ─────────────────────────────

    "battery": {
        "interval": 5,
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",

        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip": true,
        "tooltip-format": "Battery: {capacity}%"
    }
}
